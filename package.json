{
  "name": "samlify",
  "version": "2.15.0",
  "description": "Node.js library for SAML SSO",
  "main": "build/index.js",
  "keywords": [
    "nodejs",
    "saml2",
    "sso",
    "slo",
    "metadata"
  ],
  "typings": "types/index.d.ts",
  "files": [
    "build",
    "types",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "clean": "rm -rf build types",
    "build": "yarn clean && tsc",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test:types": "tsc -p tsconfig.typecheck.json && tsc -p tsconfig.json --emitDeclarationOnly && tsc -p test/consumer-types/tsconfig.json",
    "test": "vitest run && yarn test:types",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "hooks:postinstall": "ln -sf $PWD/.pre-commit.sh $PWD/.git/hooks/pre-commit"
  },
  "contributors": [
    "Tony Ngan <tonynwk919@gmail.com>"
  ],
  "author": "tngan",
  "repository": {
    "url": "https://github.com/tngan/samlify",
    "type": "git"
  },
  "license": "MIT",
  "dependencies": {
    "@authenio/xml-encryption": "^6.0.2",
    "@xmldom/xmldom": "^0.9.12",
    "xml": "^1.0.1",
    "xml-crypto": "^6.4.0",
    "xml-escape": "^1.1.0",
    "xpath": "^0.0.35"
  },
  "resolutions": {
    "diff": ">=4.0.4",
    "esbuild": "^0.25.0",
    "vitest/vite": "^6.4.3",
    "vitepress/vite": "^6.4.3",
    "vitepress/@vitejs/plugin-vue/vite": "^6.4.3"
  },
  "devDependencies": {
    "@authenio/samlify-xsd-schema-validator": "^1.0.5",
    "@eslint/js": "^9.39.5",
    "@types/node": "^25.4.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.39.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.11"
  }
}
