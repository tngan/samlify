{
  "compilerOptions": {
    "target": "es5",
    "module": "commonjs",
    "moduleResolution": "node",
    "declaration": true,
    "declarationDir": "types",
    "downlevelIteration": true,
    "sourceMap": true,
    "outDir": "./build",
    "strictNullChecks": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "lib": ["es2015"]
  },
  "include": [
    "src/**/*.ts",
    "index.ts"
  ]
}
